+    }
+
+    #[tokio::test]
+    async fn caller_without_session_can_still_open_a_valid_session() {
+        let mut client = FileServiceClient::new(MockStream::new(session_response(), false)).await.unwrap();
+        assert!(client.retrieve_directory_list(".").await.is_err());
