+#[cfg(test)]
+mod safety_ffi_tests {
+    use super::*;
+    use tokio::io::AsyncWriteExt;
+
+    fn response(channel: u32, object: idevice::xpc::XPCObject) -> Vec<u8> {
+        let body = idevice::xpc::XPCMessage::new(None, Some(object), Some(1)).encode(1).unwrap();
+        let length = (body.len() as u32).to_be_bytes();
+        let mut frame = vec![length[1], length[2], length[3], 0, 0];
+        frame.extend(channel.to_be_bytes());
+        frame.extend(body);
+        frame
+    }
+    fn client(extra: Vec<u8>) -> (*mut FileServiceHandle, tokio::io::DuplexStream) {
+        let (control, mut peer) = tokio::io::duplex(65536);
+        let mut replies = response(3, idevice::xpc!({ "NewSessionID": "mock-session" }));
+        replies.extend(extra);
+        run_sync_local(async { peer.write_all(&replies).await.unwrap(); });
+        let control: Box<dyn ReadWrite> = Box::new(control);
+        let client = run_sync_local(FileServiceClient::new(control)).unwrap();
+        let handle = Box::into_raw(Box::new(FileServiceHandle(client)));
+        let identifier = CString::new("test.owned.app").unwrap();
+        assert!(unsafe { file_service_create_session(handle,
+            IdeviceFileServiceDomain::IdeviceFileServiceDomainAppDataContainer,
+            identifier.as_ptr(), null_mut()) }.is_null());
+        (handle, peer)
+    }
+
+    #[test]
+    fn failed_directory_request_clears_output_slots_and_keeps_handle_freeable() {
+        let (handle, peer) = client(Vec::new());
+        drop(peer);
+        let path = CString::new(".").unwrap();
+        let mut names = std::ptr::dangling_mut::<*mut c_char>();
+        let mut length = 123;
+        unsafe {
+            let error = file_service_retrieve_directory_list(handle, path.as_ptr(), &mut names, &mut length);
+            assert!(!error.is_null());
+            assert!(names.is_null());
+            assert_eq!(length, 0);
+            crate::idevice_error_free(error);
+            file_service_free(handle);
+        }
+    }
+
+    #[test]
+    fn oversized_stream_download_preserves_c_ownership_and_zeroes_outputs() {
+        let (handle, _peer) = client(response(1, idevice::xpc!({ "Response": 7u64, "NewFileID": 19u64 })));
+        let (data, mut data_peer) = tokio::io::duplex(65536);
+        let mut prefix = vec![0; 36];
+        prefix.extend(u32::MAX.to_be_bytes());
+        run_sync_local(async { data_peer.write_all(&prefix).await.unwrap(); });
+        let stream = Box::into_raw(Box::new(ReadWriteOpaque { inner: Some(Box::new(data)) }));
+        let path = CString::new("known-file").unwrap();
+        let mut bytes = std::ptr::dangling_mut::<u8>();
+        let mut length = 123;
+        unsafe {
+            // with_stream consumes the stream on this failure, but borrows handle.
+            let error = file_service_retrieve_file_with_stream(handle, path.as_ptr(), stream, &mut bytes, &mut length);
+            assert!(!error.is_null());
+            assert!(CStr::from_ptr((*error).message).to_str().unwrap().contains("128 MiB"));
+            assert!(bytes.is_null());
+            assert_eq!(length, 0);
+            crate::idevice_error_free(error);
+            file_service_free(handle);
+        }
+    }
+
+    #[test]
+    fn an_empty_socket_wrapper_returns_error_without_unwinding_across_c() {
+        let socket = Box::into_raw(Box::new(ReadWriteOpaque { inner: None }));
+        let mut handle = std::ptr::dangling_mut::<FileServiceHandle>();
+        unsafe {
+            let error = file_service_new(socket, &mut handle);
+            assert!(!error.is_null());
+            assert!(handle.is_null());
+            crate::idevice_error_free(error);
+        }
+    }
+}
