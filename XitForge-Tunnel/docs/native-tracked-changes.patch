+#[cfg(test)]
+mod file_info_tests {
+    use super::*;
+    use tokio::io::{AsyncReadExt, AsyncWriteExt};
+
+    async fn info_from_afc_response(attributes: &[(&str, &str)]) -> FileInfo {
+        let (client, mut peer) = tokio::io::duplex(4096);
+        let mut afc = AfcClient::new(Idevice::new(Box::new(client), "file-info-test"));
+        let mut payload = Vec::new();
+        for (key, value) in attributes {
+            payload.extend_from_slice(key.as_bytes()); payload.push(0);
+            payload.extend_from_slice(value.as_bytes()); payload.push(0);
+        }
+        let response = AfcPacket {
+            header: AfcPacketHeader {
+                magic: MAGIC,
+                entire_len: AfcPacketHeader::LEN + payload.len() as u64,
+                header_payload_len: AfcPacketHeader::LEN,
+                packet_num: 0,
+                operation: AfcOpcode::Data,
+            },
+            header_payload: Vec::new(), payload,
+        }.serialize();
+        let server = async {
+            let mut header = [0u8; 40];
+            peer.read_exact(&mut header).await.unwrap();
+            let request_len = u64::from_le_bytes(header[8..16].try_into().unwrap());
+            let operation = u64::from_le_bytes(header[32..40].try_into().unwrap());
+            assert_eq!(operation, AfcOpcode::GetFileInfo as u64);
+            let mut request = vec![0; (request_len - 40) as usize];
+            peer.read_exact(&mut request).await.unwrap();
+            assert!(request.starts_with(b"generated-stage/p0/p1/p2/link"));
+            // The actual client must decode the null-separated AFC frame.
+            for chunk in response.chunks(7) { peer.write_all(chunk).await.unwrap(); }
+        };
+        let (info, ()) = tokio::join!(afc.get_file_info("generated-stage/p0/p1/p2/link"), server);
+        info.unwrap()
+    }
+
+    fn attributes() -> Vec<(&'static str, &'static str)> {
+        vec![("st_size", "61"), ("st_blocks", "0"), ("st_birthtime", "1700000000000000000"),
+             ("st_mtime", "1700000000000000123"), ("st_nlink", "1"), ("st_ifmt", "S_IFLNK")]
+    }
